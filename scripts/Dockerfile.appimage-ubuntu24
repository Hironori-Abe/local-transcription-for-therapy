# LoTT の Linux 配布ビルド（Full / Editor）用イメージ。
# - ggml 音声エンジン（whisper.cpp / NeMo-Speech.cpp）を Vulkan でビルドする:
#   cmake / ninja / glslc / libvulkan-dev / spirv-headers。実行時のローダー（libvulkan.so.1）は
#   ホストのものを優先し、無い環境向けのフォールバックとして libvulkan1 の実体を
#   resources/speech-engines/vulkan-loader/ へ同梱する（エンジンの隣には置かない）。
# - python3 はビルド用（ffmpeg 取得・ライセンス収集・成果物整理）。アプリには Python を同梱しない。
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=22.23.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      desktop-file-utils \
      file \
      git \
      glslc \
      gstreamer1.0-alsa \
      gstreamer1.0-plugins-base \
      gstreamer1.0-plugins-good \
      gstreamer1.0-pulseaudio \
      libayatana-appindicator3-dev \
      libfuse2 \
      libgtk-3-dev \
      libssl-dev \
      libvulkan-dev \
      libvulkan1 \
      libwebkit2gtk-4.1-dev \
      libxdo-dev \
      librsvg2-dev \
      ninja-build \
      patchelf \
      pkg-config \
      python3 \
      spirv-headers \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

# AppImage の WebKitGTK は音声再生を GStreamer に丸投げするため、プラグインを同梱しないと
# Ubuntu 以外のホスト（例 CachyOS）でデコーダがゼロになり、<audio> が読み込めず固まる。
# 配布ライセンス方針（AGENTS.md）に合わせ、同梱するのは LGPL の base/good/alsa/pulse だけ。
# GPL の gstreamer1.0-plugins-ugly / gstreamer1.0-libav / faad は入れない。
# AAC など LGPL 側にデコーダが無い形式は、実行時に同梱 LGPL ffmpeg で FLAC へ変換して再生する。
RUN set -eu; \
    plugin_dir=/usr/lib/x86_64-linux-gnu/gstreamer-1.0; \
    for forbidden in libgstlibav.so libgstfaad.so libgstx264.so libgstmpeg2dec.so libgstasf.so; do \
      if [ -e "$plugin_dir/$forbidden" ]; then \
        echo "[ERROR] GPL の GStreamer プラグインが入っています: $forbidden" >&2; exit 1; \
      fi; \
    done; \
    for required in libgstcoreelements.so libgsttypefindfunctions.so libgstwavparse.so libgstmpg123.so libgstflac.so libgstogg.so libgstvorbis.so libgstopus.so libgstisomp4.so libgstmatroska.so libgstplayback.so libgstaudioconvert.so libgstaudioresample.so; do \
      if [ ! -e "$plugin_dir/$required" ]; then \
        echo "[ERROR] 必要な GStreamer プラグインがありません: $required" >&2; exit 1; \
      fi; \
    done; \
    echo "[OK] LGPL GStreamer プラグインを確認しました"

# 同梱するフォールバック用 Vulkan ローダー（Ubuntu の libvulkan1）と、AppImage が抱える
# WebKitGTK のバージョンをビルドログへ残す（WEBKIT_DMABUF_RENDERER_FORCE_SHM 対応可否の確認用）。
RUN set -eu; \
    test -e /usr/lib/x86_64-linux-gnu/libvulkan.so.1; \
    test -f /usr/share/doc/libvulkan1/copyright; \
    echo "[INFO] libvulkan1 $(dpkg-query -W -f='${Version}' libvulkan1)"; \
    echo "[INFO] libwebkit2gtk-4.1-0 $(dpkg-query -W -f='${Version}' libwebkit2gtk-4.1-0)"

# Vulkan ビルド用ツールの存在確認（ggml-vulkan は glslc と Vulkan / SPIR-V ヘッダーを必要とする）
RUN set -eu; \
    glslc --version >/dev/null; \
    test -f /usr/include/vulkan/vulkan.h; \
    test -f /usr/include/spirv/unified1/spirv.hpp; \
    echo "[OK] Vulkan ビルド依存を確認しました"

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
    && node --version \
    && npm --version

RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable

ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /workspace
