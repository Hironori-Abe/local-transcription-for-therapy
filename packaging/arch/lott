#!/bin/sh
set -eu

# GTK表示バックエンドはホストのデスクトップ環境の既定値を使う。
# X11/XWaylandを比較する場合だけ、診断用にLOTT_GDK_BACKENDを明示する。
if [ -n "${LOTT_GDK_BACKEND:-}" ]; then
  export GDK_BACKEND="$LOTT_GDK_BACKEND"
fi

# CachyOS / NVIDIA実機ではDMA-BUF rendererを有効にするとWebKitGTKが起動しない。
# ただしWEBKIT_DISABLE_DMABUF_RENDERERはtransport modeを空にするため、DMA-BUFだけでなく
# AcceleratedBackingStore（合成器）ごと無効化し、スクロールが目に見えてカクつく。
# WEBKIT_DMABUF_RENDERER_FORCE_SHMはDMA-BUFだけを避けて合成器を維持するため、こちらを既定にする。
# 利用者がWEBKIT_*を明示していればそれを尊重する。
# DMA-BUFのハードウェア経路を再検証するときだけLOTT_ENABLE_DMABUF_RENDERER=1を指定する。
if [ -z "${LOTT_ENABLE_DMABUF_RENDERER:-}" ] \
  && [ "${WEBKIT_DISABLE_DMABUF_RENDERER+x}" != x ] \
  && [ "${WEBKIT_DMABUF_RENDERER_FORCE_SHM+x}" != x ]; then
  export WEBKIT_DMABUF_RENDERER_FORCE_SHM=1
fi

exec '/usr/lib/Local Transcription for Therapy/lott-bin' "$@"
