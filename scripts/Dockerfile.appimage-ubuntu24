FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=22.23.2

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      desktop-file-utils \
      file \
      gstreamer1.0-alsa \
      gstreamer1.0-plugins-base \
      gstreamer1.0-plugins-good \
      gstreamer1.0-pulseaudio \
      libayatana-appindicator3-dev \
      libfuse2 \
      libgtk-3-dev \
      libssl-dev \
      libwebkit2gtk-4.1-dev \
      libxdo-dev \
      librsvg2-dev \
      patchelf \
      pkg-config \
      python3 \
      python3-pip \
      python3-venv \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

# AppImage の WebKitGTK は音声再生を GStreamer に丸投げするため、プラグインを同梱しないと
# Ubuntu 以外のホスト（例 CachyOS）でデコーダがゼロになり、<audio> が読み込めず固まる。
# 配布ライセンス方針（AGENTS.md）に合わせ、同梱するのは LGPL の base/good/alsa/pulse だけ。
# GPL の gstreamer1.0-plugins-ugly / gstreamer1.0-libav / faad は入れない。
# AAC など LGPL 側にデコーダが無い形式は、実行時に同梱 LGPL ffmpeg で FLAC へ変換して再生する。
RUN set -eu; \
    plugin_dir=/usr/lib/x86_64-linux-gnu/gstreamer-1.0; \
    for forbidden in libgstlibav.so libgstfaad.so libgstx264.so libgstmpeg2dec.so libgstasf.so; do \
      if [ -e "$plugin_dir/$forbidden" ]; then \
        echo "[ERROR] GPL の GStreamer プラグインが入っています: $forbidden" >&2; exit 1; \
      fi; \
    done; \
    for required in libgstcoreelements.so libgsttypefindfunctions.so libgstwavparse.so libgstmpg123.so libgstflac.so libgstogg.so libgstvorbis.so libgstopus.so libgstisomp4.so libgstmatroska.so libgstplayback.so libgstaudioconvert.so libgstaudioresample.so; do \
      if [ ! -e "$plugin_dir/$required" ]; then \
        echo "[ERROR] 必要な GStreamer プラグインがありません: $required" >&2; exit 1; \
      fi; \
    done; \
    echo "[OK] LGPL GStreamer プラグインを確認しました"

# AppImage実行先のsystem Python（CachyOSでは3.14等）へ依存しない、再配置可能な
# Python 3.12基本ランタイムを作る。Pythonパッケージ本体は初回セットアップ時に
# app_local_data_dir配下へ導入するため、ここには標準ライブラリとpipだけを含める。
# Ubuntuはsystem Pythonのensurepipを無効化しているので、aptのpipモジュールを
# 同梱prefixへコピーし、実際の導入先は実行時のPIP_TARGETで分離する。
RUN runtime=/opt/lott-python312 \
    && mkdir -p "$runtime/bin" "$runtime/lib" \
    && cp /usr/bin/python3.12 "$runtime/bin/python3.12" \
    && cp -a /usr/lib/python3.12 "$runtime/lib/python3.12" \
    && libpython="$(ldd /usr/bin/python3.12 | awk '/libpython3[.]12[.]so[.]1[.]0/ { print $3; exit }')" \
    && if [ -n "$libpython" ]; then cp "$libpython" "$runtime/lib/libpython3.12.so.1.0"; fi \
    && ln -s python3.12 "$runtime/bin/python3" \
    && rm -f "$runtime/lib/python3.12/EXTERNALLY-MANAGED" \
    && cp -a /usr/lib/python3/dist-packages/pip "$runtime/lib/python3.12/pip" \
    && PYTHONHOME="$runtime" LD_LIBRARY_PATH="$runtime/lib" \
       "$runtime/bin/python3.12" -c 'import encodings, pip; assert encodings.__file__' \
    && PYTHONHOME="$runtime" LD_LIBRARY_PATH="$runtime/lib" \
       "$runtime/bin/python3.12" -m pip install --no-cache-dir --upgrade "pip>=25.2,<26" \
    && PYTHONHOME="$runtime" LD_LIBRARY_PATH="$runtime/lib" \
       "$runtime/bin/python3.12" -m pip --version

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
    && node --version \
    && npm --version

RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable

ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /workspace
