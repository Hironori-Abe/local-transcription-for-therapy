{
  "build": {
    "beforeBuildCommand": "npm --prefix frontend run build -- --configuration production"
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "resources": [
      "../LICENSE",
      "../NOTICE",
      "../THIRD_PARTY_LICENSES.md",
      "../licenses",
      "resources/proofread/punctuation_rules",
      "resources/ffmpeg",
      "resources/speech-engines"
    ],
    "linux": {
      "deb": {
        "depends": [
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk",
          "zenity",
          "libvulkan1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
